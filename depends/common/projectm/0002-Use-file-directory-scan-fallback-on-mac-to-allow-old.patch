+#ifdef __APPLE__
+auto Playlist::AddPath(const std::string& path, uint32_t index, bool recursive, bool allowDuplicates) -> uint32_t
+{
+    uint32_t presetsAdded{0};
+    ProjectMDirectory::Scan(path, recursive, [&](const std::string& filename, const std::string& name) {
+        const auto dot = name.find_last_of('.');
+        if (dot == std::string::npos || name.substr(dot) != ".milk")
+            return;
+        const auto insertionIndex = index == InsertAtEnd ? InsertAtEnd : index + presetsAdded;
+        // AddItem already adjusts playback history when inserting before an existing item.
+        if (AddItem(filename, insertionIndex, allowDuplicates))
+            ++presetsAdded;
+    });
+    return presetsAdded;
+}

Subject: [PATCH] Keep Apple directory scanning compatible with older deployment targets

Use full paths, recursive traversal, safe directory ownership, and correct texture
extensions/basenames. Avoid following directory symlinks and adjust playlist
history only once per insertion.

--- a/src/DirectoryScanner.hpp
+++ b/src/DirectoryScanner.hpp
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <dirent.h>
+#include <sys/stat.h>
+
+#include <functional>
+#include <memory>
+#include <string>
+
+namespace ProjectMDirectory {
+
+// POSIX traversal keeps Apple deployment targets independent of std::filesystem.
+inline void Scan(const std::string& directory, bool recursive,
+                 const std::function<void(const std::string&, const std::string&)>& callback)
+{
+    if (directory.empty())
+        return;
+
+    std::unique_ptr<DIR, decltype(&closedir)> entries(opendir(directory.c_str()), closedir);
+    if (!entries)
+        return;
+
+    const std::string prefix = directory + (directory.back() == '/' ? "" : "/");
+    while (const auto* entry = readdir(entries.get()))
+    {
+        const std::string name(entry->d_name);
+        if (name == "." || name == "..")
+            continue;
+
+        const std::string filename = prefix + name;
+        struct stat info{};
+        if (lstat(filename.c_str(), &info) != 0)
+            continue;
+
+        if (S_ISDIR(info.st_mode))
+        {
+            if (recursive)
+                Scan(filename, true, callback);
+        }
+        else
+        {
+            // Follow links to files, but never recurse into directory links/cycles.
+            if (S_ISLNK(info.st_mode) && stat(filename.c_str(), &info) != 0)
+                continue;
+            if (S_ISREG(info.st_mode))
+                callback(filename, name);
+        }
+    }
+}
+
+} // namespace ProjectMDirectory

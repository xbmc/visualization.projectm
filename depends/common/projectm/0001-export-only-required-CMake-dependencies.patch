Subject: [PATCH] Export only the CMake dependencies linked by the fork

Keep dynamic OpenGL loading independent of consumer-side GL discovery, while
retaining dependencies when Windows desktop GL or Boost is actually enabled.

--- a/src/libprojectM/projectM4Config.cmake.in
+++ b/src/libprojectM/projectM4Config.cmake.in
@@ -7,7 +7,3 @@
-if(NOT "@ENABLE_EMSCRIPTEN@") # ENABLE_EMSCRIPTEN
-    if("@ENABLE_GLES@") # ENABLE_GLES
-        list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
-        find_dependency(OpenGL COMPONENTS GLES3)
-    else()
-        find_dependency(OpenGL)
-    endif()
+# The fork resolves GL dynamically except for Windows desktop OpenGL.
+if("@CMAKE_SYSTEM_NAME@" STREQUAL "Windows" AND NOT "@ENABLE_EMSCRIPTEN@" AND NOT "@ENABLE_GLES@")
+    find_dependency(OpenGL)

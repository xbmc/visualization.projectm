diff --git a/src/libprojectM/Timing.hpp b/src/libprojectM/Timing.hpp
new file mode 100644
index 0000000..17a3b7e
--- /dev/null
+++ b/src/libprojectM/Timing.hpp
@@ -0,0 +1,37 @@
+#pragma once
+
+#include "Logging.hpp"
+
+#include <chrono>
+#include <string>
+#include <utility>
+
+namespace libprojectM {
+
+// TEMPORARY: Logs the wall time spent in a scope, for measuring preset loading on slow devices.
+class ScopedTiming
+{
+public:
+    explicit ScopedTiming(std::string label, double thresholdMs = 0.0)
+        : m_label(std::move(label))
+        , m_thresholdMs(thresholdMs)
+        , m_start(std::chrono::steady_clock::now())
+    {
+    }
+
+    ~ScopedTiming()
+    {
+        const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - m_start).count();
+        if (ms >= m_thresholdMs)
+        {
+            LOG_INFO("[Timing] " + m_label + ": " + std::to_string(ms) + " ms")
+        }
+    }
+
+private:
+    std::string m_label;
+    double m_thresholdMs;
+    std::chrono::steady_clock::time_point m_start;
+};
+
+} // namespace libprojectM
